# === Supabase (필수 - 다른 기기에서도 접근하려면) ===
# supabase.com > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# === Claude API Key (AI 검색에 사용) ===
# console.anthropic.com에서 발급
CLAUDE_API_KEY=sk-ant-...

# === Slack Webhook URL (듀데이트 알림에 사용) ===
# Slack App > Incoming Webhooks에서 생성
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# === 뷰어 모드 접근 코드 (읽기 전용 공유) ===
# 이 코드를 설정하면 /viewer 페이지에서 읽기 전용으로 데이터를 볼 수 있습니다
VIEWER_ACCESS_CODE=your_code_here
